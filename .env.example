# Example variable names. Domainwright does not read environment variables itself:
# your application maps them into `new Domainwright({ ... })`. Never commit real values.

# Cloudflare (see docs/credentials-and-permissions.md for the token permissions)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Registrar: name.com (only if you search for or register domains)
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=
# production | sandbox
NAMECOM_ENVIRONMENT=sandbox

# Tenant-bound ownership challenges: a random string of at least 32 characters. Keep it stable.
DOMAINWRIGHT_OWNERSHIP_SECRET=

# Opt-in sandbox tests (npm run test:sandbox). Use test accounts only.
NAMECOM_SANDBOX_USERNAME=
NAMECOM_SANDBOX_TOKEN=
DOMAINWRIGHT_SANDBOX_ALLOW_PURCHASE=
CLOUDFLARE_TEST_API_TOKEN=
CLOUDFLARE_TEST_ACCOUNT_ID=
CLOUDFLARE_TEST_ZONE=
